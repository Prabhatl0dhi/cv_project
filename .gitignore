# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Generated runtime outputs
output/*.mp4
output/*.avi
output/*.mkv
screenshot_*.jpg
screenshot_*.png
*.log

# Keep output directory in git
!output/.gitkeep
